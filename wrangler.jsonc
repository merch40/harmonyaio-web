{
  "name": "harmonyaio-web",
  "main": "src/index.js",
  "compatibility_date": "2025-01-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },
  "vars": {
    // Base URL the release resolver fetches channel pointers from and
    // builds artifact URLs against. Front Door custom domain in front of
    // the paazharupdatescf9d 'updates' container (ADR 0028).
    "UPDATE_ORIGIN": "https://updates.harmonyaio.com",
    // Channel preference order for install one-liners that do not ask for a
    // specific channel. Stable wins the moment its first release is
    // published; until then requests fall through to dogfood. Only a
    // missing channel pointer falls through, never a verification failure.
    "DEFAULT_CHANNEL": "stable,dogfood",
    "ALLOWED_CHANNELS": "dogfood,stable"
  }
}

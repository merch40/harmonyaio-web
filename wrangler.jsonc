{
  "name": "harmonyaio-web",
  "main": "src/index.js",
  "compatibility_date": "2025-01-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },
  // REQUIRED OUT-OF-BAND CONFIG — the newsletter signup (/api/signup) needs
  // two values that must be set as SECRETS, never as dashboard plaintext vars:
  //   npx wrangler secret put BREVO_API_KEY   # Brevo -> Settings -> API keys
  //   npx wrangler secret put BREVO_LIST_ID   # numeric list id from Brevo -> Contacts -> Lists
  // Optional:
  //   npx wrangler secret put BREVO_WELCOME_TEMPLATE_ID  # transactional template id;
  //     when set, new signups get a welcome email from the template's sender
  //     (requires harmonyaio.com authenticated as a Brevo sending domain).
  // Secrets survive `wrangler deploy`; dashboard plaintext vars DO NOT — any
  // deploy replaces the whole vars set with this file's "vars" block, which is
  // how the signup broke in July 2026. If either value is missing the endpoint
  // returns {"error":"Server not configured"}.
  //
  // GET /api/signup/health probes the same config end to end (env present +
  // Brevo accepts the key); the weekly cron below runs the probe too, which
  // doubles as keep-alive activity so Brevo's inactivity auto-deactivation
  // can't silently kill the key again.
  "triggers": {
    "crons": ["0 14 * * MON"]
  },
  "vars": {
    // Base URL the release resolver fetches channel pointers from and
    // builds artifact URLs against. Front Door custom domain in front of
    // the paazharupdatescf9d 'updates' container (ADR 0028).
    "UPDATE_ORIGIN": "https://updates.harmonyaio.com",
    // Channel for install one-liners that do not ask for one. Deliberately
    // just "stable" (which has no releases yet): the plain public one-liner
    // stays inert until the first stable release is published, and dogfood
    // installs must opt in explicitly with HARMONY_CHANNEL=dogfood. The
    // value accepts a comma-separated preference list if fallback is ever
    // wanted again.
    "DEFAULT_CHANNEL": "stable",
    "ALLOWED_CHANNELS": "dogfood,stable"
  }
}
